# Telegram - obtenha o token pelo @BotFather e gere um secret aleatório para o webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# URL pública da implantação Vercel, sem barra final
APP_BASE_URL=https://seu-projeto.vercel.app

# Firebase Realtime Database (URL do seu banco)
FIREBASE_DATABASE_URL=https://seu-projeto-default-rtdb.firebaseio.com
# Conteúdo JSON da conta de serviço, em uma única linha. Nunca publique este segredo.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Opcional: em vez do JSON acima, pode usar FIREBASE_SERVICE_ACCOUNT_BASE64
FIREBASE_SERVICE_ACCOUNT_BASE64=

# API compatível com OpenAI Chat Completions. Configure chave e modelo do provedor contratado.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_SYSTEM_PROMPT=Você é MestreXit.ia, assistente criativo e especialista em tecnologia. Responda em português brasileiro por padrão, com clareza, naturalidade e atenção ao contexto. Siga as leis e as políticas do provedor.
AI_HISTORY_MESSAGES=16
AI_TIMEOUT_MS=45000

# Imagem: API compatível com OpenAI Images (endpoint completo opcional)
IMAGE_API_KEY=
IMAGE_API_URL=https://api.openai.com/v1/images/generations
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=medium
IMAGE_DAILY_LIMIT=5
IMAGE_TIMEOUT_MS=15000
MAX_IMAGE_BYTES=9500000

# Licenciamento e limites
MAX_KEYS_PER_GENERATION=20
KEY_ATTEMPTS_MAX=5
KEY_ATTEMPTS_WINDOW_MS=900000
UPDATE_LEASE_MS=120000
