# Configure estes quatro valores em Vercel → Settings → Environment Variables
TELEGRAM_BOT_TOKEN=
FIREBASE_DATABASE_URL=https://mestrexit-ia-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_JSON=
OPENAI_API_KEY=

# ID administrativo fixo no código: 8646015281.
# A mesma OPENAI_API_KEY é usada para respostas e geração de imagens.
# Para registrar o webhook, informe a URL pública ao executar:
# npm run set:webhook -- https://seu-projeto.vercel.app

# Opcionais — mantenha vazias se não precisar mudar os padrões:
# ADMIN_TELEGRAM_ID=ID_AUTORIZADO
# MAX_KEYS_PER_GENERATION=30
# IMAGE_DAILY_LIMIT=5
# IMAGE_TIMEOUT_MS=55000
# IMAGE_MODEL=gpt-image-1
# IMAGE_API_KEY= (se usar uma chave separada)
