
{
  "version": 2,
  "builds": [
    {
      "src": "telegram.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "logo.png",
          "tutorial-id.png"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/telegram/?",
      "dest": "/telegram.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
