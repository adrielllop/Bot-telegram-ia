{
  "version": 2,
  "builds": [
    {
      "src": "telegram.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/telegram/?",
      "dest": "/telegram.js"
    }
  ],
  "functions": {
    "telegram.js": {
      "maxDuration": 60,
      "includeFiles": "*.png"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
